// ART Bundle Plugin - MCP Configuration Template
// 
// This file shows how the MCP server is configured in your opencode.jsonc
// The install.sh script will automatically merge this configuration into your local .opencode/opencode.jsonc or .opencode/opencode.json (if it exists)
//

{
  "mcp": {
    "art-mcp": {
      // Type: Cloud-based remote MCP server
      "type": "remote",
      
      // URL: GCP Cloud Run hosted ART-MCP service
      "url": "https://art-mcp-1005318772721.us-west1.run.app/mcp",
      
      // Authentication: API key from environment variable
      // Users must set: export ARTMCP_AUTH_API_KEY="your-api-key"
      // This is REQUIRED - the MCP server will reject requests without it
      "headers": {
        "Authorization": "Bearer {env:ARTMCP_AUTH_API_KEY}"
      },
      
      // 1 hour timeout for long-running operations
      "timeout": 3600000,

      // Enable this MCP server
      "enabled": true
    }
  }
}
